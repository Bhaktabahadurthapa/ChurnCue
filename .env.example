# Safe, non-secret runtime configuration
CHURNCUE_HOST=0.0.0.0
CHURNCUE_PORT=8000
CHURNCUE_LOG_LEVEL=INFO
CHURNCUE_DATABASE_PATH=data/churncue.db
CHURNCUE_ARTIFACT_DIR=data/artifacts
CHURNCUE_DEMO_DATA_PATH=data/demo/customer_churn_demo.csv
CHURNCUE_MAX_INPUT_ROWS=5000
CHURNCUE_MAX_DEMO_ROWS=50
CHURNCUE_MAX_STRING_LENGTH=200
CHURNCUE_RANDOM_STATE=42
# Compose-only host port override; the container always listens on 8000.
CHURNCUE_PUBLISHED_PORT=8000
