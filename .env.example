# Safe, non-secret runtime configuration
CLIENTREVIVE_HOST=0.0.0.0
CLIENTREVIVE_PORT=8000
CLIENTREVIVE_LOG_LEVEL=INFO
CLIENTREVIVE_DATABASE_PATH=data/clientrevive.db
CLIENTREVIVE_ARTIFACT_DIR=data/artifacts
CLIENTREVIVE_DEMO_DATA_PATH=data/demo/customer_churn_demo.csv
CLIENTREVIVE_MAX_INPUT_ROWS=5000
CLIENTREVIVE_MAX_DEMO_ROWS=500
CLIENTREVIVE_MAX_STRING_LENGTH=200
CLIENTREVIVE_RANDOM_STATE=42
# Compose-only host port override; the container always listens on 8000.
CLIENTREVIVE_PUBLISHED_PORT=8000
